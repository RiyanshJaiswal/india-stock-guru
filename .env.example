# Current/live NSE equity quotes are provided by the Python jugaad-data/NSELive service.
# Optional override if the Python executable is not auto-detected.
# NSE_PYTHON_BIN=

# Market news providers (server-side only).
# Add tokens in Railway Variables; never expose them in VITE_* client variables.
# MARKETAUX_API_TOKEN=
# NEWSAPI_API_KEY=
# GNEWS_API_KEY=

# Optional AI provider. If these are unset, the assistant uses its safe local fallback.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
